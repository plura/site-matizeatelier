#: core/acf.php:26 core/acf.php:27
msgid "Theme Settings"
msgstr "Definições do Tema"

#: core/form.php:39
msgid "Security check failed."
msgstr "Verificação de segurança falhou."

#: core/form.php:51
msgid "Too many messages sent. Please try again later."
msgstr "Muitas mensagens enviadas. Por favor, tente mais tarde."

#: core/form.php:82 core/i18n.php:14
msgid "Please fill in all required fields."
msgstr "Por favor preencha todos os campos obrigatórios."

#: core/form.php:85
msgid "Please enter a valid email address."
msgstr "Por favor introduza um endereço de email válido."

#: core/form.php:90
msgid "Form Submission"
msgstr "Envio de Formulário"

#: core/form.php:122 core/i18n.php:15
msgid "Something went wrong. Please try again."
msgstr "Algo correu mal. Por favor tente novamente."

#: core/form.php:130
msgid "We received your enquiry"
msgstr "Recebemos o seu pedido"

#: core/form.php:136
#, php-format
msgid ""
"Dear %s, thank you for getting in touch. We have received your message and "
"will be in touch with you shortly. Below you will find a copy of your "
"message for your records."
msgstr ""
"Caro/a %s, obrigado/a por entrar em contacto. Recebemos a sua mensagem e "
"entraremos em contacto consigo em breve. Em baixo encontra uma cópia da sua "
"mensagem para que possa consultar mais tarde."

#: core/form.php:143
msgid "Thank you for reaching out. We'll be in touch soon."
msgstr "Obrigado pela sua mensagem. Entraremos em breve em contacto consigo."

#: core/form.php:145
msgid "A copy of your message has been sent to your email address."
msgstr "Foi enviada uma cópia da sua mensagem para o seu endereço de email."

#: core/image-color-backfill.php:7 core/image-color-backfill.php:8
#: core/image-color-backfill.php:27
msgid "Image color backfill"
msgstr "Classificação de cores das imagens"

#: core/image-color-backfill.php:17
msgid "You do not have permission to access this page."
msgstr "Não tem permissão para aceder a esta página."

#: core/image-color-backfill.php:28
msgid ""
"Analyze existing image attachments in batches. Existing manual color "
"overrides are preserved."
msgstr ""
"Analise as imagens existentes em lotes. As cores definidas manualmente serão "
"preservadas."

#: core/image-color-backfill.php:34
#, php-format
msgid "Processed in this batch: %1$d. Scanned in total: %2$d."
msgstr "Processadas neste lote: %1$d. Analisadas no total: %2$d."

#: core/image-color-backfill.php:46
#, php-format
msgid "%d image could not be analyzed. Check the PHP error log for details."
msgstr ""
"Não foi possível analisar imagem %d. Consulte o registo de erros do PHP para "
"mais detalhes."

#: core/image-color-backfill.php:53
msgid "Backfill complete."
msgstr "Classificação concluída."

#: core/image-color-backfill.php:59
#, php-format
msgid "Progress — scanned: %1$d, failed: %2$d."
msgstr "Progresso — analisadas: %1$d, falhadas: %2$d."

#: core/image-color-backfill.php:71
msgid "Process next batch"
msgstr "Processar próximo lote"

#: core/image-color-backfill.php:73
msgid "Start again from the beginning"
msgstr "Recomeçar desde o início"

#: core/image-color-backfill.php:80
msgid "You do not have permission to perform this action."
msgstr "Não tem permissão para executar esta ação."

