<mjml>
	<mj-head>
		<mj-title>%FORM_NAME%</mj-title>
		<mj-preview>%FORM_NAME% — %SITE_NAME%</mj-preview>

		<mj-attributes>
			<mj-all font-family="Helvetica Neue, Helvetica, Arial, sans-serif" />
			<mj-text color="#0A0907" font-size="14px" line-height="1.7" />
		</mj-attributes>

		<mj-style>
			.badge {
				background-color: #EC6F63;
				border-radius: 999px;
				color: #FFFFFF;
				display: inline-block;
				font-size: 10px;
				font-weight: bold;
				letter-spacing: 0.18em;
				padding: 8px 18px;
				text-transform: uppercase;
			}
			.form-data {
				border-collapse: collapse;
				width: 100%;
			}
			.form-data tr:last-child td {
				border-bottom: none;
			}
			.form-data td {
				border-bottom: 1px solid #EDE6D6;
				padding: 14px 0;
				vertical-align: top;
			}
			.label-cell {
				color: #8C887D;
				font-size: 10px;
				font-weight: bold;
				letter-spacing: 0.12em;
				padding-right: 20px;
				padding-top: 16px;
				text-transform: uppercase;
				white-space: nowrap;
				width: 30%;
			}
			.value-cell {
				color: #0A0907;
				font-size: 14px;
				line-height: 1.7;
			}
			/* .footer-name and .credit colours moved to direct mj-text attributes
			   (always inlined by MJML) — a class in this style block can't reach
			   the raw percent-sign tokens before PHP replaces them with real
			   tags, so this only styles layout, not colour. */
			.footer p {
				font-size: 11px;
				letter-spacing: 0.03em;
				line-height: 1.9;
				margin: 0 0 6px;
			}
			.footer-social a {
				color: #7FB8A4 !important;
			}
			@media screen and (max-width: 480px) {
				.label-cell {
					border-bottom: none !important;
					display: block !important;
					padding-bottom: 2px !important;
					padding-top: 16px !important;
					white-space: normal !important;
					width: 100% !important;
				}
				.value-cell {
					display: block !important;
					padding-top: 0 !important;
					width: 100% !important;
				}
			}
		</mj-style>
	</mj-head>

	<mj-body background-color="#E1D7BE" width="560px">

		<!-- Logo -->
		<mj-section background-color="#E1D7BE" padding="40px 24px 24px">
			<mj-column>
				<mj-image
					src="https://matizeatelier.pt/wp/wp-content/uploads/2026/04/mtz-1200x600-1.png"
					alt="%SITE_NAME%"
					href="%SITE_URL%"
					width="200px"
					padding="0"
				/>
			</mj-column>
		</mj-section>

		<!-- Body card -->
		<mj-section background-color="#FFFFFF" border-radius="10px" padding="0">
			<mj-column padding="40px">
				<mj-raw>%INTRO%</mj-raw>
				<mj-text padding="0 0 28px">
					<span class="badge">%FORM_NAME%</span>
				</mj-text>
				<mj-raw>
					<table class="form-data" role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
						<tr>
							<td class="label-cell">Name</td>
							<td class="value-cell">%mtz_name%</td>
						</tr>
						<tr>
							<td class="label-cell">Email</td>
							<td class="value-cell">%mtz_email%</td>
						</tr>
						<tr>
							<td class="label-cell">Telephone</td>
							<td class="value-cell">%mtz_phone%</td>
						</tr>
						<tr>
							<td class="label-cell">Message</td>
							<td class="value-cell">%mtz_message%</td>
						</tr>
					</table>
				</mj-raw>
			</mj-column>
		</mj-section>

		<!-- Spacer -->
		<mj-section padding="20px 0 0">
			<mj-column></mj-column>
		</mj-section>

		<!-- Footer, dark, matches the site's own footer treatment.
		     Colours set via mj-text's own attributes (always inlined by MJML)
		     rather than a style-block class, since some clients ignore
		     embedded stylesheets and the raw placeholder tokens have no tag
		     to hang a class off until PHP replaces them - otherwise they'd
		     render as invisible black-on-black text. -->
		<mj-section background-color="#0A0907" border-radius="10px" padding="32px 40px 4px">
			<mj-column>
				<mj-text
					color="#E1D7BE"
					font-size="11px"
					font-weight="bold"
					letter-spacing="0.16em"
					text-transform="uppercase"
					align="center"
					padding="0 0 14px"
				>%SITE_NAME%</mj-text>
				<mj-raw>
					<div class="footer" style="text-align:center; color:#A39C8C; font-size:11px; letter-spacing:0.03em; line-height:1.9;">
						%CONTACT_BLOCK%
						%SOCIAL_BLOCK%
					</div>
				</mj-raw>
				<mj-divider border-color="#2A2620" border-width="1px" padding="20px 0" />
				<mj-text
					color="#6B6558"
					font-size="10px"
					letter-spacing="0.03em"
					align="center"
					padding="0 0 20px"
				>
					&copy; %YEAR% %SITE_NAME% &mdash; Powered by <a href="https://plura.pt" target="_blank" style="color:#6B6558;">Plura</a>
				</mj-text>
			</mj-column>
		</mj-section>

	</mj-body>
</mjml>
