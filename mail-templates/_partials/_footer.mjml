<!-- mj-wrapper groups the 3 sub-sections below under one continuous dark
     background — separate sibling mj-sections would each render their own
     rounded box with a gap between them, breaking the "one footer" look. -->
<mj-wrapper background-color="#0A0907" border-radius="10px" padding="32px 0 4px">

	<mj-section padding="0 40px 20px">
		<mj-column>
			<mj-text
				color="#E1D7BE"
				font-size="11px"
				font-weight="bold"
				letter-spacing="0.16em"
				text-transform="uppercase"
				align="center"
				padding="0"
			>%SITE_NAME%</mj-text>
		</mj-column>
	</mj-section>

	<!-- Address | Email + Phone -->
	<mj-section padding="0 40px 16px">
		<mj-column>
			<mj-text align="center" color="#A39C8C" font-size="11px" letter-spacing="0.03em" line-height="1.9" padding="0">
				%CONTACT_ADDRESS%
			</mj-text>
		</mj-column>
		<mj-column>
			<mj-text align="center" color="#A39C8C" font-size="11px" letter-spacing="0.03em" line-height="1.9" padding="0">
				%CONTACT_EMAIL%<br />%CONTACT_PHONE%
			</mj-text>
		</mj-column>
	</mj-section>

	<!-- Social links, divider, credit -->
	<mj-section padding="0 40px">
		<mj-column>
			<mj-raw>
				<tr>
					<td align="center" style="font-size:0; padding:0 0 20px; word-break:break-word;">
						<div class="footer" style="text-align:center; color:#A39C8C; font-size:11px; letter-spacing:0.03em; line-height:1.9;">
							%SOCIAL_BLOCK%
						</div>
					</td>
				</tr>
			</mj-raw>
			<mj-divider border-color="#2A2620" border-width="1px" padding="0 0 20px" />
			<mj-text
				color="#6B6558"
				font-size="10px"
				letter-spacing="0.03em"
				align="center"
				padding="0 0 20px"
			>
				&copy; %YEAR% %SITE_NAME% &mdash; Powered by <a href="https://plura.pt" target="_blank" style="color:#6B6558;">Plura</a>
			</mj-text>
		</mj-column>
	</mj-section>

</mj-wrapper>
