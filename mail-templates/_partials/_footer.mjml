<mj-section background-color="#0A0907" border-radius="10px" padding="32px 40px 4px">
	<mj-column>
		<mj-text
			color="#E1D7BE"
			font-size="11px"
			font-weight="bold"
			letter-spacing="0.16em"
			text-transform="uppercase"
			align="center"
			padding="0 0 14px"
		>%SITE_NAME%</mj-text>
		<mj-raw>
			<div class="footer" style="text-align:center; color:#A39C8C; font-size:11px; letter-spacing:0.03em; line-height:1.9;">
				%CONTACT_BLOCK%
				%SOCIAL_BLOCK%
			</div>
		</mj-raw>
		<mj-divider border-color="#2A2620" border-width="1px" padding="20px 0" />
		<mj-text
			color="#6B6558"
			font-size="10px"
			letter-spacing="0.03em"
			align="center"
			padding="0 0 20px"
		>
			&copy; %YEAR% %SITE_NAME% &mdash; Powered by <a href="https://plura.pt" target="_blank" style="color:#6B6558;">Plura</a>
		</mj-text>
	</mj-column>
</mj-section>
