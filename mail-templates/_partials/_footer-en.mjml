<!-- mj-wrapper groups the 3 sub-sections below under one continuous dark
     background — separate sibling mj-sections would each render their own
     rounded box with a gap between them, breaking the "one footer" look.
     Language-forked (see _footer-pt.mjml) only for the Address/Contact
     column titles below — everything else here is language-neutral data.
     css-class="mtz-card" gets the mobile-only outer gutter (see _head.mjml). -->
<mj-wrapper background-color="#0A0907" padding="32px 0 4px" css-class="mtz-card">

	<mj-section mj-class="mtz-hpad" padding-top="0" padding-bottom="20px">
		<mj-column>
			<mj-text mj-class="mtz-footer-brand">%SITE_NAME%</mj-text>
		</mj-column>
	</mj-section>

	<!-- Address | Email + Phone. css-class="mtz-footer-address" adds a
	     mobile-only gap below this column, since it stacks directly above
	     "Contact" on narrow screens instead of sitting beside it. -->
	<mj-section mj-class="mtz-hpad" padding-top="0" padding-bottom="16px">
		<mj-column css-class="mtz-footer-address">
			<mj-text mj-class="mtz-footer-label">Address</mj-text>
			<mj-text mj-class="mtz-footer-value">
				<a href="%CONTACT_ADDRESS_URL%" style="color:#A39C8C !important; text-decoration:none !important;">%CONTACT_ADDRESS%</a>
			</mj-text>
		</mj-column>
		<mj-column>
			<mj-text mj-class="mtz-footer-label">Contact</mj-text>
			<mj-text mj-class="mtz-footer-value">
				<a href="%CONTACT_EMAIL_URL%" style="color:#A39C8C !important; text-decoration:none !important;">%CONTACT_EMAIL%</a><br />
				<a href="%CONTACT_PHONE_HREF%" style="color:#A39C8C !important; text-decoration:none !important;">%CONTACT_PHONE%</a>
			</mj-text>
		</mj-column>
	</mj-section>

	<!-- Social links, divider, credit -->
	<mj-section mj-class="mtz-hpad" padding-top="0" padding-bottom="0">
		<mj-column>
			<!-- Individual per-platform placeholders (not a plugin-built block) so
			     styling/order/which platforms to show live entirely here.
			     Only Instagram/Facebook for now — add Pinterest/LinkedIn back
			     (see mtz_get_social_placeholders()) once those are in use. -->
			<mj-raw>
				<tr>
					<td align="center" style="font-size:0; padding:0 0 20px; word-break:break-word;">
						<div style="text-align:center; font-size:11px; letter-spacing:0.03em; line-height:1.9;">
							<a href="%SOCIAL_INSTAGRAM_URL%" style="color:#7FB8A4; text-decoration:none;">Instagram</a>
							&nbsp;&middot;&nbsp;
							<a href="%SOCIAL_FACEBOOK_URL%" style="color:#7FB8A4; text-decoration:none;">Facebook</a>
						</div>
					</td>
				</tr>
			</mj-raw>
			<mj-divider border-color="#2A2620" border-width="1px" padding="0 0 20px" />
			<mj-text mj-class="mtz-footer-credit">
				&copy; %YEAR% %SITE_NAME% &mdash; Powered by <a href="https://plura.pt" target="_blank" style="color:#6B6558; font-weight:bold;">Plura</a>
			</mj-text>
		</mj-column>
	</mj-section>

</mj-wrapper>

<!-- Bottom spacer — mirrors the header's own top margin (see _header.mjml's
     40px top padding) so the whole email has equal breathing room top/bottom,
     instead of ending flush against the footer's own tight internal padding. -->
<mj-section padding="40px 0 0">
	<mj-column></mj-column>
</mj-section>
