<!-- Tells clients that DO respect it (mainly Apple Mail) not to auto-link and
     re-style phone numbers/addresses/dates as their own "smart" links. Gmail
     ignores this and needs the zero-width-non-joiner trick in the PHP-built
     placeholders instead (see mtz_get_contact_placeholders()). -->
<mj-raw>
	<meta name="format-detection" content="telephone=no, date=no, address=no, email=no">
</mj-raw>

<mj-attributes>
	<mj-all font-family="Helvetica Neue, Helvetica, Arial, sans-serif" />
	<mj-text color="#0A0907" font-size="14px" line-height="1.7" />
</mj-attributes>

<mj-style>
	.email-intro {
		color: #0A0907;
		font-size: 13px;
		line-height: 1.8;
		margin: 0 0 28px;
	}
	.form-data {
		border-collapse: collapse;
		width: 100%;
	}
	.form-data tr:last-child td {
		border-bottom: none;
	}
	.form-data td {
		border-bottom: 1px solid #EDE6D6;
		padding: 14px 0;
		vertical-align: top;
	}
	.label-cell {
		color: #8C887D;
		font-size: 10px;
		font-weight: bold;
		letter-spacing: 0.12em;
		padding-right: 20px;
		padding-top: 16px;
		text-transform: uppercase;
		white-space: nowrap;
		width: 30%;
	}
	.value-cell {
		color: #0A0907;
		font-size: 14px;
		line-height: 1.7;
	}
	@media screen and (max-width: 480px) {
		.label-cell {
			border-bottom: none !important;
			display: block !important;
			padding-bottom: 2px !important;
			padding-top: 16px !important;
			white-space: normal !important;
			width: 100% !important;
		}
		.value-cell {
			display: block !important;
			padding-top: 0 !important;
			width: 100% !important;
		}
	}
</mj-style>
