<!-- Generic, field-agnostic fallback template — used by mtz_build_email_body()
     whenever no theme-supplied template overrides it via the
     'mtz_email_template' filter (see plugin/includes/core/form.php).
     Works for any [data-mtz-form], however many fields it has or whatever
     they're named: %FIELDS% is a dynamically-built table (PHP loops over
     whatever was actually submitted), not named per-field placeholders like
     the bespoke contact/ templates use. %INTRO% is optional raw HTML (empty
     for a plain notification, a "thank you" paragraph for an auto-reply) —
     PHP supplies it already wrapped in <p class="email-intro">. -->
<mjml>
	<mj-head>
		<mj-title>%FORM_NAME%</mj-title>
		<mj-preview>%FORM_NAME% — %SITE_NAME%</mj-preview>
		<mj-include path="../_partials/_head.mjml" />
	</mj-head>

	<mj-body background-color="#E1D7BE" width="560px">

		<!-- Logo -->
		<mj-section background-color="#E1D7BE" padding="40px 24px 24px">
			<mj-column>
				<mj-image
					src="%LOGO_URL%"
					alt="%SITE_NAME%"
					href="%SITE_URL%"
					width="200px"
					padding="0"
				/>
			</mj-column>
		</mj-section>

		<!-- Body card — coral title band + white content, one continuous
		     rounded box (see _footer-en.mjml/_footer-pt.mjml's mj-wrapper for the same technique). -->
		<mj-wrapper border-radius="10px" padding="0">
			<mj-section background-color="#EC6F63" padding="18px 40px">
				<mj-column>
					<mj-text
						color="#FFFFFF"
						font-weight="bold"
						font-size="14px"
						letter-spacing="0.12em"
						text-transform="uppercase"
						align="center"
						padding="0"
					>%FORM_NAME%</mj-text>
				</mj-column>
			</mj-section>
			<mj-section background-color="#FFFFFF" padding="0">
				<mj-column padding="40px">
					<mj-raw>%INTRO%</mj-raw>
					<mj-raw>
						<table class="form-data" role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
							%FIELDS%
						</table>
					</mj-raw>
				</mj-column>
			</mj-section>
		</mj-wrapper>

		<!-- Spacer -->
		<mj-section padding="20px 0 0">
			<mj-column></mj-column>
		</mj-section>

		<mj-include path="../_partials/_footer-en.mjml" />

	</mj-body>
</mjml>
