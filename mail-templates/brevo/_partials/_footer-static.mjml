<!-- Do NOT add an unsubscribe link: Brevo appends its own footer with one when
     the email has none. To place it manually instead, add this inside the
     last mj-column (Brevo then skips its footer):
     <mj-raw><tr><td align="center" style="font-size:10px; padding:0 0 20px;"><a href="{{ unsubscribe }}" style="color:#6B6558;">Cancelar subscrição</a></td></tr></mj-raw>

     Values come from the live site's theme options; update them here if those
     change. &zwnj; stops Gmail re-styling the phone/email as blue links. -->

<!-- Gap between the body card and the footer -->
<mj-section padding="20px 0 0">
	<mj-column></mj-column>
</mj-section>

<mj-wrapper background-color="#0A0907" padding="32px 0 4px" css-class="mtz-card">

	<mj-section mj-class="mtz-hpad" padding-top="0" padding-bottom="20px">
		<mj-column>
			<mj-text mj-class="mtz-footer-brand">Matize Atelier</mj-text>
		</mj-column>
	</mj-section>

	<mj-section mj-class="mtz-hpad" padding-top="0" padding-bottom="16px">
		<mj-column css-class="mtz-footer-address">
			<mj-text mj-class="mtz-footer-label">Morada</mj-text>
			<mj-text mj-class="mtz-footer-value">
				<a href="https://maps.app.goo.gl/qY5GDrE6mRERUAkKA" style="color:#A39C8C !important; text-decoration:none !important;">Rua Pedro Costa 1274A<br />2820-185 Charneca da Caparica<br />Portugal</a>
			</mj-text>
		</mj-column>
		<mj-column>
			<mj-text mj-class="mtz-footer-label">Contacto</mj-text>
			<mj-text mj-class="mtz-footer-value">
				<a href="mailto:info@matizeatelier.pt" style="color:#A39C8C !important; text-decoration:none !important;">info&zwnj;@&zwnj;matizeatelier&zwnj;.pt</a><br />
				<a href="tel:+351919937298" style="color:#A39C8C !important; text-decoration:none !important;">+351&zwnj; 919&zwnj; 937&zwnj; 298</a>
			</mj-text>
		</mj-column>
	</mj-section>

	<mj-section mj-class="mtz-hpad" padding-top="0" padding-bottom="0">
		<mj-column>
			<mj-raw>
				<tr>
					<td align="center" style="font-size:0; padding:0 0 20px; word-break:break-word;">
						<!-- mj-raw inherits no mj-attributes: font and dot color must be set here. -->
						<div style="color:#6B6558; font-family:Helvetica Neue, Helvetica, Arial, sans-serif; text-align:center; font-size:11px; letter-spacing:0.03em; line-height:1.9;">
							<a href="https://www.instagram.com/matize.atelier/" style="color:#7FB8A4; text-decoration:none;">Instagram</a>
							&nbsp;&middot;&nbsp;
							<a href="https://www.facebook.com/830525070142912/" style="color:#7FB8A4; text-decoration:none;">Facebook</a>
						</div>
					</td>
				</tr>
			</mj-raw>
			<mj-divider border-color="#2A2620" border-width="1px" padding="0 0 20px" />
			<!-- Year is literal: bump it in the first issue of each new year. -->
			<mj-text mj-class="mtz-footer-credit">
				&copy; 2026 Matize Atelier &middot; Powered by <a href="https://plura.pt" target="_blank" style="color:#6B6558; font-weight:bold;">Plura</a>
			</mj-text>
		</mj-column>
	</mj-section>

</mj-wrapper>

<!-- Mirrors the header's 40px top margin -->
<mj-section padding="40px 0 0">
	<mj-column></mj-column>
</mj-section>
