	<mj-column>
		<mj-image
			src="https://matizeatelier.pt/email/images/mtz-logo-black.png"
			alt="Matize Atelier"
			href="https://matizeatelier.pt"
			width="200px"
			padding="0"
		/>
	</mj-column>
</mj-section>
