<!-- Columns stack on mobile. Equal side padding on both keeps the image and
     text aligned in either layout. Source image: 520px wide (retina). -->
<mj-section mj-class="mtz-card-body mtz-hpad" padding-top="16px" padding-bottom="16px">
	<mj-column padding="0 8px 16px">
		<!-- EDIT: src and alt -->
		<mj-image
			src="https://placehold.co/520x390/E1D7BE/0A0907.png?text=IMAGE+PLACEHOLDER+520px"
			alt="Descrição da imagem"
			padding="0"
		/>
	</mj-column>
	<mj-column padding="0 8px 16px">
		<!-- EDIT: title and text -->
		<mj-text font-weight="bold" letter-spacing="0.08em" text-transform="uppercase" padding="0 0 8px">Título</mj-text>
		<mj-text padding="0">Texto curto.</mj-text>
	</mj-column>
</mj-section>
