<!-- Small label beside a lead and body, echoing the site's offset captions. The
     inset sits on the section so both columns still align once stacked. -->
<mj-section mj-class="mtz-card-body mtz-hpad" padding-top="44px" padding-bottom="40px">
	<mj-column width="32%" padding="0 16px 14px 0">
		<!-- EDIT: label -->
		<mj-text font-size="11px" font-weight="bold" letter-spacing="0.2em" line-height="1.9" text-transform="uppercase" padding="0">Etiqueta</mj-text>
	</mj-column>
	<mj-column width="68%">
		<!-- EDIT: lead and body -->
		<mj-text font-size="20px" font-weight="bold" line-height="1.4" padding="0 0 16px">Frase de abertura.</mj-text>
		<mj-text font-size="15px" padding="0">Texto de apoio.</mj-text>
	</mj-column>
</mj-section>
