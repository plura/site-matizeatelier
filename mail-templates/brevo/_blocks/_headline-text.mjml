<!-- Bold, uppercase and tracking stand in for the brand display font, which
     email clients can't load reliably. Keep body copy to 1-3 short lines. -->
<mj-section mj-class="mtz-card-body">
	<mj-column mj-class="mtz-hpad" padding-top="40px" padding-bottom="8px">
		<!-- EDIT: headline -->
		<mj-text font-size="22px" font-weight="bold" letter-spacing="0.06em" line-height="1.3" text-transform="uppercase" align="center" padding="0 0 18px">Título</mj-text>
		<!-- EDIT: body copy -->
		<mj-text align="center" padding="0">Primeira linha.<br />Segunda linha.</mj-text>
	</mj-column>
</mj-section>
