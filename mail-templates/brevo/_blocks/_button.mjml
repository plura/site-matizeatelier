<!-- Black label: white on this coral falls below readable contrast at button size.
     Escape & as &amp; in the href when adding UTM parameters. -->
<mj-section mj-class="mtz-card-body">
	<mj-column mj-class="mtz-hpad" padding-top="20px" padding-bottom="20px">
		<!-- EDIT: href and label -->
		<mj-button
			href="https://matizeatelier.pt"
			background-color="#EC6F63"
			color="#0A0907"
			font-size="13px"
			font-weight="bold"
			letter-spacing="0.12em"
			text-transform="uppercase"
			border-radius="6px"
			inner-padding="15px 32px"
			padding="0"
		>Etiqueta do botão</mj-button>
	</mj-column>
</mj-section>
