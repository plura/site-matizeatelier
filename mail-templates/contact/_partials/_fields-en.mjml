<!-- mj-raw lands directly in the column's <tbody>. Without this <tr><td>, HTML5
     parsers close the outer tables early, cutting the background in Roundcube. -->
<mj-raw>
	<tr>
		<td style="padding:0;">
			<table class="form-data" style="font-family:Helvetica Neue, Helvetica, Arial, sans-serif;" role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
				<tr>
					<td class="label-cell">Name</td>
					<td class="value-cell">%mtz_name%</td>
				</tr>
				<tr>
					<td class="label-cell">Email</td>
					<td class="value-cell">%mtz_email%</td>
				</tr>
				<tr>
					<td class="label-cell">Telephone</td>
					<td class="value-cell">%mtz_phone%</td>
				</tr>
				<tr>
					<td class="label-cell">Message</td>
					<td class="value-cell">%mtz_message%</td>
				</tr>
			</table>
		</td>
	</tr>
</mj-raw>
