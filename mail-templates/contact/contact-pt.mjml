<mjml>
	<mj-head>
		<mj-title>%FORM_NAME%</mj-title>
		<mj-preview>%FORM_NAME% — %SITE_NAME%</mj-preview>
		<mj-include path="../_partials/_head.mjml" />
	</mj-head>

	<mj-body>

		<mj-include path="../_partials/_header.mjml" />

		<!-- Body card — coral title band + white content, one continuous
		     rounded box (see _footer-en.mjml/_footer-pt.mjml's mj-wrapper for the same technique).
		     css-class="mtz-card" gets the mobile-only outer gutter (see _head.mjml). -->
		<mj-wrapper padding="0" css-class="mtz-card">
			<mj-include path="../_partials/_title-band.mjml" />
			<mj-section mj-class="mtz-card-body">
				<mj-column mj-class="mtz-hpad mtz-card-vpad">
					<mj-include path="./_partials/_fields-pt.mjml" />
				</mj-column>
			</mj-section>
		</mj-wrapper>

		<!-- Spacer -->
		<mj-section padding="20px 0 0">
			<mj-column></mj-column>
		</mj-section>

		<mj-include path="../_partials/_footer-pt.mjml" />

	</mj-body>
</mjml>
